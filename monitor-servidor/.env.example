SUPABASE_SERVICE_ROLE_KEY=
WORKER_ID_BASE=hostinger-01
POLL_INTERVAL_MS=5000
HEARTBEAT_MS=30000
CONCURRENCY_PARALELA=5
CONCURRENCY_KURIER=3
CONCURRENCY_PAUTAS=3
INCLUDE_LOCAL_PROXY=true
LOCAL_PROXY_URL=http://127.0.0.1:8089
LOCAL_PROXY_TOKEN=

# Kurier engine (invoca a edge function existente)
KURIER_MAX_LOTES=5
KURIER_DELAY_MS=1200
PARALELA_TIMEOUT_MS=1500000
PAUTAS_TIMEOUT_MS=1500000

# DJEN Termos Paralela — controle de custo das falhas de rede
PARALELA_UNIT_BUDGET_MS=90000        # orçamento por (tribunal, monitoramento, dia)
PARALELA_DEGRADE_DELAY_MS=500        # espera antes de degradar a página
PARALELA_WINDOW_BACKOFF_MAX_MS=4000  # teto do backoff entre janelas com falha
PARALELA_SLOW_UNIT_BUDGET_MS=120000  # orçamento dos tribunais lentos (TST, TRT2, TRT15, TJSP, TJRJ, TJMG)

# Fase 4 — orçamento justo (espera de rate limit não conta; extensão por progresso)
PARALELA_UNIT_BUDGET_MAX_MS=240000       # teto absoluto por unidade, mesmo com progresso
PARALELA_UNIT_PROGRESS_GRACE_MS=30000    # folga concedida após cada página válida
PARALELA_RATE_LIMIT_PAUSE_MS=8000        # pausa antes de repetir a janela em 429
PARALELA_RATE_LIMIT_BACKOFF_MS=5000      # base do backoff dedicado ao 429